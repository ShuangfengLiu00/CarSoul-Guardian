# ===========================
# CarSoul Guardian - .gitignore
# ===========================

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
pythonenv*/

# Testing / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/build/
*.local
.vite/
.eslintcache

# ---------- Environment & secrets ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Database ----------
*.sqlite3
*.db
pgdata/
postgres_data/

# ---------- Redis ----------
redis_data/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Build artifacts ----------
*.tgz
.parcel-cache/
*.tsbuildinfo

# Vite / TS build outputs accidentally force-tracked earlier (keep worktree clean)
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/tsconfig.node.tsbuildinfo

# ---------- AI / model caches ----------
*.bin
*.pt
*.ckpt
chroma_db/
vector_db/

# ---------- Tool working dirs ----------
.workbuddy/
.trae/
.trae-html-share-packages/

# ---------- HTML documentation/presentation folders ----------
carsoul-demo-plan/
carsoul-guardian-ppt/
carsoul-guardian-ppt-v2/
carsoul-guardian-ppt-v3/
carsoul-guardian-prd/
carsoul-guardian-strategy/
carsoul-lifecycle-prd/
carsoul-positioning/
carsoul-prd/
carsoul-tech-design/
goai-agent-loop/
goai-dasaijiedu/
goai-milestone/
goai-scoring-battlemap/

# ---------- Temporary/test/scratch files ----------
# 纪律：本段只允许「带路径前缀」的模式，禁止裸文件名。
# 裸模式（如 index.ts / evolutionService.ts）会遮蔽全仓同名文件，
# 曾导致 8 个 barrel 与 1 个业务 service 被静默排除、远端仓库 clone 后构建失败。
# 新增规则前先执行：git check-ignore -v <路径> 逐条核验。
/test.html
/test.ts
/test.txt
/test[0-9].txt
/scratch/

# 临时验证脚本（一次性排查用，不入库）
/backend/_t_*.py

# 兜底：Python 包标识文件永不忽略
!**/__init__.py
