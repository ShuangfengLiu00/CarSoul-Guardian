# ====================================================
# CarSoul Guardian - Environment Variables (Example)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ====================================================

# ---------- Environment ----------
# development | staging | production
ENVIRONMENT=development

# ---------- Database (PostgreSQL) ----------
# Local dev: postgresql://carsoul:carsoul@localhost:5432/carsoul_guardian
# Docker:    postgresql://carsoul:carsoul@postgres:5432/carsoul_guardian
DATABASE_URL=postgresql://carsoul:carsoul@localhost:5432/carsoul_guardian

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=please-change-me-to-a-random-secret
# Access token lifetime (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- CarSoul World Model bridge (carModel engine) ----------
# Guardian calls the carModel prediction engine over HTTP for real
# SOH / failure / residual-value / counterfactual results.
# Engine default port is :8000 (see carModel start.sh).
CARSOUL_WORLD_API_URL=http://localhost:8000
#
# REQUIRED. Service-to-service Bearer token for calling carModel.
# carModel enforces global Bearer auth; if this is EMPTY, every
# Guardian -> carModel business call returns {"error":"world_model_401"}
# (fail-closed by design, NOT a bug). The bridge will look healthy in
# logs while every prediction silently degrades — so fill it in.
#
# How to mint (run in the carModel repo, NOT here):
#   python tools/mint_service_token.py
# It signs with carModel's CARSOUL_API_JWT_SECRET. That is a DIFFERENT
# key from Guardian's JWT_SECRET above — the two services intentionally
# do NOT share a signing key. See carModel docs/auth-token-chain.md.
CARSOUL_WORLD_API_TOKEN=
#
# Optional. Pin a real vehicle id for demos. Leave EMPTY in normal use:
# when empty the UI honestly shows "no data" instead of passing off some
# arbitrary vehicle as "your car".
CARSOUL_WORLD_DEFAULT_VEHICLE_ID=

# ---------- AI / LLM ----------
# OpenAI-compatible API key (OpenAI / Azure / local gateway)
OPENAI_API_KEY=
# Model identifier, e.g. gpt-4o-mini / qwen-plus / deepseek-chat
MODEL_NAME=gpt-4o-mini
# Optional base url override (for Azure / proxy / local LLM)
OPENAI_API_BASE=

# ---------- AI Agent ----------
# Agent default language
AGENT_LANGUAGE=zh-CN
# Enable agent proactive reminders
AGENT_PROACTIVE=true

# ---------- Knowledge Base (TASK009 RAG) ----------
# Path to persistent vector store (used when ChromaDB is installed)
VECTOR_DB_PATH=./ai-agent/memory/vector_store
# ChromaDB collection name
CHROMA_COLLECTION=carsoul_guardian
# Note: Without OPENAI_API_KEY, the system uses hash-based embeddings.
#       Without ChromaDB installed, the system uses in-memory vector store.
#       The knowledge base always works (graceful degradation).

# ---------- CORS ----------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Frontend (Vite needs VITE_ prefix) ----------
# DEV: leave empty so Vite proxy (/api -> :8001 Guardian backend) handles routing.
#       DO NOT point this at :8000 (carModel prediction engine) — that misroutes
#       every /api/* call and yields a silent 404 wall. Set only for production
#       builds where a real reverse proxy/API base is deployed.
VITE_API_BASE_URL=
VITE_APP_TITLE=CarSoul Guardian
